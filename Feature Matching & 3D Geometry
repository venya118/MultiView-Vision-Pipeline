import cv2
import numpy as np

def compute_stereo_geometry(img1_gray, img2_gray):
    """
    Extracts SIFT keypoints, matches them between two stereo images, 
    and estimates the Fundamental Matrix using RANSAC.
    """
    # 1. Detect SIFT features and descriptors
    sift = cv2.SIFT_create()
    kp1, des1 = sift.detectAndCompute(img1_gray, None)
    kp2, des2 = sift.detectAndCompute(img2_gray, None)

    # 2. Match descriptors using FLANN matcher
    matcher = cv2.FlannBasedMatcher({'algorithm': 1, 'trees': 5}, {'checks': 50})
    raw_matches = matcher.knnMatch(des1, des2, k=2)

    # 3. Apply Lowe's Ratio Test to keep good matches
    good_pts1, good_pts2 = [], []
    for m, n in raw_matches:
        if m.distance < 0.75 * n.distance:
            good_pts1.append(kp1[m.queryIdx].pt)
            good_pts2.append(kp2[m.trainIdx].pt)

    pts1 = np.int32(good_pts1)
    pts2 = np.int32(good_pts2)

    # 4. Compute Fundamental Matrix via RANSAC (Outlier removal)
    F, mask = cv2.findFundamentalMat(pts1, pts2, cv2.FM_RANSAC)
    
    return F, pts1[mask.ravel() == 1], pts2[mask.ravel() == 1]
