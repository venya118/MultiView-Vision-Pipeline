import cv2
import numpy as np
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA

def segment_and_compress(image, n_clusters=3, pca_components=2):
    """
    Segments an image using K-Means clustering and performs 
    PCA dimensionality reduction on the pixel color values.
    """
    # Flatten the image into a 2D array of RGB pixels
    pixels = image.reshape((-1, 3)).astype(np.float32)

    # 1. K-Means Segmentation
    kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
    labels = kmeans.fit_predict(pixels)
    segmented_flat = kmeans.cluster_centers_[labels]
    segmented_img = segmented_flat.reshape(image.shape).astype(np.uint8)

    # 2. PCA Dimensionality Reduction
    pca = PCA(n_components=pca_components)
    reduced_features = pca.fit_transform(pixels)

    return segmented_img, reduced_features
